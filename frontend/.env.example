# Public Google OAuth client ID used by Google Identity Services in the browser.
# Use the same client ID as GOOGLE_CLIENT_ID in backend/.env.
VITE_GOOGLE_CLIENT_ID=

# Leave unset when the frontend and API are served from the same origin.
# For a separately hosted API only, set the full public API base URL, e.g. https://api.example.com/api
# VITE_API_BASE_URL=
