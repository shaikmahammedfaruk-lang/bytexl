# ==========================================
# BrandShield AI - Global Environment Config
# Docker Compose deployment settings. Replace every value marked "replace".
# ==========================================

ENVIRONMENT=production

# Database
MONGO_URI=mongodb://mongodb:27017
DB_NAME=brandshield_ai

# Security & Sessions
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_unique_random_secret_at_least_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# URLs
# Set this to the public HTTPS URL where users open the app (no trailing slash).
FRONTEND_URL=https://your-public-domain.example

# Google OAuth 2.0 (Optional)
# Create a Web application OAuth client. Add your public site origin to
# Authorized JavaScript origins in Google Cloud Console.
GOOGLE_CLIENT_ID=
# Public browser client ID; set to the same value as GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
# Usually leave blank: the frontend and API share one public origin.
# Set only when hosting the API on a separate public origin.
VITE_API_BASE_URL=

# SMTP Email Configuration (Optional - for Password Reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=security@brandshield.ai
REQUIRE_EMAIL_VERIFICATION=false

# Threat Intelligence Engine Modes
INSTAGRAM_DEMO_MODE=true
PLATFORM_SANDBOX_MODE=true
