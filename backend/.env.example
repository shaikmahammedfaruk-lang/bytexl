# =================================================================
# BrandShield AI - Environment Configuration Reference (.env.example)
# =================================================================

# Server & Database Settings
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
MONGO_URI=mongodb://localhost:27017
DB_NAME=brandshield_ai

# Authentication & JWT Configuration
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth 2.0 browser client ID (same ID as frontend VITE_GOOGLE_CLIENT_ID).
# In Google Cloud Console, authorize http://localhost:5173 for local development.
GOOGLE_CLIENT_ID=

# Email / SMTP Configuration for Password Reset & Verification Emails
# Leave blank to use the development reset-link simulator.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=security@brandshield.ai
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
REQUIRE_EMAIL_VERIFICATION=false

# Social & Meta Graph APIs
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_DEMO_MODE=true
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
X_BEARER_TOKEN=
LINKEDIN_ACCESS_TOKEN=
PLATFORM_SANDBOX_MODE=true
